{
    // ----------------------------------------------------------------
    // ###################### GENERAL SETTINGS ########################
    // theme & ui
    "workbench.colorTheme": "Dracula Theme",
    "window.commandCenter": false,
    "window.titleBarStyle": "native",
    "chat.commandCenter.enabled": false,
    "window.zoomLevel": 0,
    "workbench.activityBar.location": "top",
    "workbench.startupEditor": "none",
    "problems.showCurrentInStatus": false,
    "workbench.editor.tabSizing": "fixed",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "workbench.layoutControl.enabled": false,
    "window.customTitleBarVisibility": "never",
    "workbench.editor.enablePreview": false,
    "security.workspace.trust.banner": "never",
    "window.menuBarVisibility": "hidden",
    "workbench.editor.showTabs": "none",
    "editor.minimap.enabled": false,
    "terminal.integrated.stickyScroll.enabled": true,
    // ----------------------------------------------------------------
    // editor & terminal
    "editor.fontFamily": "Fira Code",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    // "editor.fontFamily": "Monaspace Argon Var",
    "terminal.integrated.fontFamily": "Fira Code",
    "editor.formatOnPaste": true,
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.indentSize": "tabSize",
    "terminal.integrated.tabs.location": "left",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "zsh"
        },
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "files.insertFinalNewline": true,
    "better-comments.highlightPlainText": true,
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "//",
            "color": "#474747",
            "strikethrough": true,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "*",
            "color": "#98C379",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        }
    ],
    // ----------------------------------------------------------------
    //syncing
    "settingsSync.ignoredSettings": [
        "window.titleBarStyle",
        "window.customTitleBarVisibility",
    ],
    // ----------------------------------------------------------------
    // ####################### Copilot SETTINGS ####################
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "cpp": true,
        "latex": true
    },
    "inlineChat.enableV2": false,
    // ----------------------------------------------------------------
    // ####################### EXTENSIONS SETTINGS ####################
    // cpp
    "C_Cpp.autocompleteAddParentheses": true,
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.lambda": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.type": "sameLine",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, TabWidth: 4, ColumnLimit: 0}",
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "workbench.settings.applyToAllProfiles": [
        "C_Cpp.clang_format_style",
        "C_Cpp.clang_format_fallbackStyle"
    ],
    // ----------------------------------------------------------------
    // ssh
    "remote.SSH.configFile": "~/.ssh/config",
    // ----------------------------------------------------------------
    // git stuff
    "diffEditor.ignoreTrimWhitespace": false,
    "git.openRepositoryInParentFolders": "never",
    "git.statusLimit": 50,
    "git.confirmSync": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4o",
    "gitlens.ai.experimental": false,
    "gitlens.ai.enabled": false,
    // ----------------------------------------------------------------
    //cmake 
    "cmake.buildBeforeRun": false,
    "cmake.options.statusBarVisibility": "compact",
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.showNotAllDocumentsSavedQuestion": false,
    "cmake.options.advanced": {
        "build": {
            "statusBarVisibility": "inherit",
            "inheritDefault": "visible"
        },
        "launch": {
            "statusBarVisibility": "inherit",
            "inheritDefault": "visible"
        },
        "debug": {
            "statusBarVisibility": "hidden",
            "inheritDefault": "hidden"
        },
        "cpack": {
            "statusBarVisibility": "hidden",
            "inheritDefault": "hidden"
        },
        "workflow": {
            "statusBarVisibility": "hidden",
            "inheritDefault": "hidden"
        },
        "launchTarget": {
            "statusBarVisibility": "hidden",
            "inheritDefault": "hidden"
        },
        "buildTarget": {
            "statusBarVisibility": "hidden",
            "inheritDefault": "hidden"
        }
    },
    // ----------------------------------------------------------------
    // latex
    "latex-workshop.latex.autoBuild.run": "onSave",
    "ltex.java.path": "/home/forestgump/.nix-profile/",
    // define external tools
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-interaction=nonstopmode",
                "-synctex=1",
                "%DOCFILE%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    // define recipes
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex → biber → pdflatex²",
            "tools": [
                "pdflatex",
                "biber",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "pdflatex → bibtex → pdflatex²",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "simple pdflatex",
            "tools": [
                "pdflatex"
            ]
        }
    ],
    // ----------------------------------------------------------------
    // error lens
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "warning"
    ],
    "errorLens.enabled": true,
    // ----------------------------------------------------------------
    // tree todo
    "todo-tree.filtering.ignoreGitSubmodules": true,
    "todo-tree.highlights.enabled": false,
    "todo-tree.highlights.foregroundColourScheme": [],
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
        "?",
        "!",
        "todo",
        "lastedit",
        "LASTEDIT",
        "last edit",
    ],
    "todo-tree.general.tagGroups": {
        "TODO": [
            "TODO",
            "todo"
        ],
        "LASTEDIT": [
            "lastedit",
            "LASTEDIT",
            "last edit"
        ],
    },
    "[nix]": {
        "editor.defaultFormatter": "jnoortheen.nix-ide",
        "editor.formatOnSaveMode": "file", // <- full file, not partial
        "editor.codeActionsOnSave": {}
    },
    "nix.formatterPath": "nixfmt", // or "nixpkgs-fmt" or "alejandra"    // ----------------------------------------------------------------
    // ############## DISABLE SHIT FOR PERFORMANCE ####################
    // Exclude folders from search / file watchers
    "files.watcherExclude": {
        "**/build/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true
    },
    // Disable automatic TypeScript/JavaScript IntelliSense for non-TS projects
    "typescript.tsserver.enable": false,
    "javascript.suggest.enabled": false,
    // Disable telemetry and update checks
    "telemetry.telemetryLevel": "off",
    "update.mode": "manual",
    //Disable Python/Jupyter autostarts if you don’t use them
    "python.jediEnabled": false,
    "python.analysis.indexing": false,
    // Reduce Git integration cost
    "git.enabled": true,
    "git.autorefresh": true,
    "git.untrackedChanges": "hidden",
    "git.blame.editorDecoration.enabled": false,
    "workbench.statusBar.visible": false,
}
